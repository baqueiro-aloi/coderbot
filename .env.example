# Absolute host path of the target git checkout coderbot works on. Mounted into
# the container at the same path (Claude's per-project state and the e2e
# docker.sock stack both depend on host==container paths).
CODEBOT_REPO_PATH=
# Where the backlog lives: "gdoc" (a Google Doc, default) or "github" (a GitHub
# Projects v2 board).
CODEBOT_TASK_SOURCE=gdoc
# Google Doc id of the improvements backlog. Required when CODEBOT_TASK_SOURCE=gdoc.
CODEBOT_DOC_ID=
# GitHub Projects v2 board, when CODEBOT_TASK_SOURCE=github: the project URL
# (https://github.com/orgs/<owner>/projects/<n>), or owner and number separately.
# Tasks are the board's cards backed by ISSUES of the target repo (draft cards are
# ignored); codebot picks from the pick column(s), moves cards to "In progress" /
# "In review" / "Done", and marks ownership with labels "codebot:<instance>".
CODEBOT_GH_PROJECT_URL=
CODEBOT_GH_PROJECT_OWNER=
CODEBOT_GH_PROJECT_NUMBER=
# Optional: Status column names (must match the board; case-insensitive). Pick
# statuses may be a comma-separated list.
CODEBOT_GH_PROJECT_PICK_STATUSES=Ready
CODEBOT_GH_PROJECT_ACTIVE_STATUS=In progress
CODEBOT_GH_PROJECT_REVIEW_STATUS=In review
CODEBOT_GH_PROJECT_DONE_STATUS=Done
# Optional: "owner/repo" whose issues are the tasks (defaults to the checkout's origin).
CODEBOT_GH_ISSUE_REPO=
# Activity trail: at every milestone the bot posts a note (message body included) on
# the backlog item — an issue comment on GitHub, one comment thread per task on the
# Google Doc (needs the full Drive scope: re-run scripts/setup_oauth.py on installs
# created before this option). "off" disables it.
CODEBOT_ACTIVITY_TRAIL=on
# Optional: when the target repo has no "Code Review" GitHub Actions workflow, codebot
# seeds a backlog item asking for one. "off" stops seeding that item (useful when PR
# review already happens some other way).
CODEBOT_SELF_HEAL_CODE_REVIEW=on
# Optional: project name used in prompts (defaults to the repo dir name).
CODEBOT_PROJECT_NAME=
# PAT with "repo" scope; add the "project" scope when CODEBOT_TASK_SOURCE=github
# (read:project alone cannot move cards).
GH_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Coding CLI: "claude" (default) or "opencode".
CODEBOT_AGENT=claude
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: defaults to claude-fable-5 / medium when empty.
CLAUDE_MODEL=
CLAUDE_EFFORT=
# Optional: model used when CLAUDE_MODEL runs out of usage credits (HTTP 429).
# Defaults to claude-opus-5; set to an empty value to disable the fallback.
CLAUDE_FALLBACK_MODEL=
CLAUDE_FALLBACK_COOLDOWN_SECONDS=
# Required when CODEBOT_AGENT=opencode. Credentials are stored privately in
# data/opencode/ by scripts/setup.sh, not in this file.
OPENCODE_PROVIDER=
OPENCODE_MODEL=
# May be a comma-separated list: mail is SENT to the first address; mail FROM any of
# them is trusted (replies, approvals, ABORT/STATUS/DONE commands).
CODEBOT_USER_EMAIL=
# Optional: only bullets under this heading in the backlog doc are pickable (e.g.
# "New:"). Empty = every top-level bullet in the doc.
CODEBOT_DOC_SECTION=
# Optional: hand-picked instance name ([a-z0-9-]); tags email subjects, branches and
# mailbox commands ("ABORT <instance>"). Defaults to a generated id persisted in
# data/instance_id.
CODEBOT_INSTANCE=
CODEBOT_LOG_LEVEL=DEBUG
# Optional: maximum verification/internal-review repair rounds (defaults to 3).
CODEBOT_QUALITY_GATE_MAX_ROUNDS=3
# Optional: maximum OpenSpec archive repair rounds (defaults to 3).
CODEBOT_ARCHIVE_MAX_ROUNDS=3
# Optional: consecutive failures of one state before codebot stops retrying and emails
# you (WAIT_STUCK; defaults to 5), and consecutive question round-trips per phase
# before the same escalation (defaults to 8).
CODEBOT_MAX_STATE_FAILURES=5
CODEBOT_QUESTION_MAX_ROUNDS=8
# Optional: consecutive merge-conflict resolution attempts on one PR before escalating
# (defaults to 3).
CODEBOT_CONFLICT_MAX_ROUNDS=3
# Optional tuning (defaults shown). Timeouts in seconds.
CODEBOT_POLL_INTERVAL=120
CODEBOT_AGENT_TIMEOUT=7200
CODEBOT_E2E_TIMEOUT=3600
CODEBOT_E2E_MAX_ROUNDS=5
CODEBOT_SUBPROCESS_TIMEOUT=120
CODEBOT_REVIEW_WAIT_TIMEOUT=2700
CODEBOT_REVIEW_MAX_ROUNDS=3
CODEBOT_PR_THREAD_MAX_ROUNDS=3
CODEBOT_MAX_ATTACH_BYTES=23068672
# Evidence videos (the stitched Playwright mp4) are uploaded to Google Drive and
# linked from the PR email and the activity trail instead of attached. "off", or a
# failed upload, attaches the file instead (subject to the cap above).
CODEBOT_EVIDENCE_UPLOAD=on
# Optional: Drive folder id that receives the videos. Empty: a "Codebot evidence"
# folder is found or created at the root of the bot account's My Drive.
CODEBOT_DRIVE_FOLDER_ID=
# Optional: silence check-ins. While a task is in flight, codebot emails a check-in on
# the task thread each time it has been quiet (nothing sent or received) for the next
# interval of this back-off; the last interval repeats. "off" disables them.
CODEBOT_PING_SCHEDULE=30m,1h,2h,3h,5h,8h
# Optional: the compose file e2e/run.sh brings up, torn down by codebot after a
# timed-out run (relative to e2e/; skipped when absent).
CODEBOT_E2E_COMPOSE_FILE=docker-compose.e2e.yaml
# Optional: liveness. The tick loop touches data/heartbeat while a tick is younger than
# CODEBOT_HEARTBEAT_MAX_TICK (defaults to the agent timeout + 15 min); healthcheck.sh
# reports unhealthy past CODEBOT_HEARTBEAT_STALE seconds (360) and kills the container
# past CODEBOT_HEARTBEAT_HARD (9000) so `restart: unless-stopped` restarts it.
CODEBOT_HEARTBEAT_MAX_TICK=
CODEBOT_HEARTBEAT_STALE=360
CODEBOT_HEARTBEAT_HARD=9000
# Optional: project-specific runtime facts prepended to every working prompt (how to
# run the tests, what is NOT available in the container...). One fact per line; the
# file data/environment.md is used when this is unset.
CODEBOT_ENVIRONMENT_NOTES=
# Optional: trunk branch codebot syncs from, branches off of, opens PRs against, and
# resets to on abort (defaults to "main").
CODEBOT_BASE_BRANCH=main
# Optional: only needed if the target repo has its own .claude/settings.json with an
# "apiKeyHelper" that reads this variable. Claude Code always tries apiKeyHelper before
# CLAUDE_CODE_OAUTH_TOKEN, with no fallback if it fails/is empty — so a target repo's own
# apiKeyHelper convention silently breaks codebot's OAuth auth unless this is set to a
# real key from https://console.anthropic.com/ (billed per-token, separate from your
# subscription plan). Leave blank if the target repo has no such setting.
CLAUDE_API_KEY=
